{
  "name": "git-blog-preact-markdown",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx build/dev.ts",
    "build": "tsx build/build.ts",
    "start": "tsx build/serve.ts",
    "lint": "eslint src build --ext .ts,.tsx",
    "typecheck": "tsc",
    "test": "NODE_ENV=test jest --silent --config=jest.config.cjs",
    "test:watch": "NODE_ENV=test jest --watch --silent --config=jest.config.cjs",
    "prepare": "husky install",
    "prettier": "prettier --config ./.prettierrc --write ./src ./build"
  },
  "license": "MIT",
  "dependencies": {
    "classnames": "^2.5.1",
    "d3": "^7.6.1",
    "d3-sankey": "^0.12.3",
    "dayjs": "^1.11.5",
    "feed": "^4.2.2",
    "gray-matter": "^4.0.3",
    "markdown-it": "^13.0.1",
    "markdown-it-anchor": "^8.6.4",
    "markdown-it-prism": "^2.3.0",
    "minisearch": "^7.1.1",
    "preact": "^10.29.2",
    "preact-render-to-string": "^6.7.0",
    "prism-themes": "^1.9.0",
    "prismjs": "^1.29.0",
    "sharp": "^0.33.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.1.2",
    "@commitlint/config-conventional": "^17.1.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/preact": "^3.2.4",
    "@types/d3": "^7.4.0",
    "@types/d3-sankey": "^0.11.2",
    "@types/jest": "^29.0.0",
    "@types/markdown-it": "^13.0.0",
    "@types/node": "^18.7.16",
    "@types/node-fetch": "^2.6.2",
    "@typescript-eslint/eslint-plugin": "^5.36.2",
    "@typescript-eslint/parser": "^5.36.2",
    "esbuild": "^0.23.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^8.5.0",
    "husky": "^8.0.1",
    "jest": "^29.0.2",
    "jest-environment-jsdom": "^29.0.2",
    "lint-staged": "^13.0.3",
    "node-fetch": "^2",
    "prettier": "^2.7.1",
    "ts-jest": "^29.4.11",
    "tsx": "^4.19.2"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": "eslint --cache",
    "*.**": "prettier --check --ignore-unknown"
  },
  "volta": {
    "node": "20.3.0"
  }
}
